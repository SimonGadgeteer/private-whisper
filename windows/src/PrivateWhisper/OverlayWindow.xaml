<Window x:Class="PrivateWhisper.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Whisper Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootBorder"
            CornerRadius="15"
            Background="#DD1E1E1E"
            Padding="16,9"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="RecordingDot"
                         Width="10" Height="10"
                         Fill="#FF5252"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0"
                         Visibility="Collapsed" />
                <StackPanel x:Name="LevelBars"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Height="22"
                            Visibility="Collapsed" />
                <TextBlock x:Name="MessageText"
                           Foreground="White"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="380" />
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Foreground="#BBBBBB"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       Margin="0,5,0,0"
                       Visibility="Collapsed" />
            <Button x:Name="DoneButton"
                    Content="Done"
                    Width="70"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="DoneButton_Click" />
        </StackPanel>
    </Border>
</Window>
