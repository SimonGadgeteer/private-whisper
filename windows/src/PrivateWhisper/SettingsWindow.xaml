<Window x:Class="PrivateWhisper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Whisper — Settings"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="16">

            <TextBlock Text="Hotkeys" FontWeight="Bold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Dictation (hold to talk)" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                <ComboBox x:Name="HotkeyCombo" Grid.Row="0" Grid.Column="1" Margin="0,2" />
                <TextBlock Text="Command mode (hold)" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                <ComboBox x:Name="CommandHotkeyCombo" Grid.Row="1" Grid.Column="1" Margin="0,2" />
            </Grid>

            <TextBlock Text="Audio" FontWeight="Bold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Microphone" VerticalAlignment="Center" />
                <ComboBox x:Name="MicrophoneCombo" Grid.Column="1" Margin="0,2" />
            </Grid>

            <TextBlock Text="Transcription" FontWeight="Bold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Whisper model" VerticalAlignment="Center" />
                <ComboBox x:Name="WhisperModelCombo" Grid.Column="1" Margin="0,2" />
            </Grid>

            <TextBlock Text="Cleanup (LLM)" FontWeight="Bold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Enable cleanup" VerticalAlignment="Center" Grid.Row="0" />
                <CheckBox x:Name="CleanupEnabledCheck" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" />
                <TextBlock Text="LM Studio URL" VerticalAlignment="Center" Grid.Row="1" />
                <TextBox x:Name="LmStudioUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                <TextBlock Text="Cleanup model" VerticalAlignment="Center" Grid.Row="2" />
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                    <Button x:Name="RefreshModelsButton" Content="Refresh" DockPanel.Dock="Right" Width="70" Margin="6,0,0,0" Click="RefreshModelsButton_Click" />
                    <ComboBox x:Name="CleanupModelCombo" IsEditable="True" />
                </DockPanel>
                <TextBlock Text="Timeout (seconds)" VerticalAlignment="Center" Grid.Row="3" />
                <TextBox x:Name="TimeoutBox" Grid.Row="3" Grid.Column="1" Margin="0,2" Width="80" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,2" Foreground="Gray" FontSize="11"
                           TextWrapping="Wrap"
                           Text="Routing: LM Studio if reachable → embedded llama-server → raw transcript." />
            </Grid>

            <TextBlock Text="Overlay" FontWeight="Bold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Show overlay" VerticalAlignment="Center" Grid.Row="0" />
                <CheckBox x:Name="OverlayEnabledCheck" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" />
                <TextBlock Text="Position" VerticalAlignment="Center" Grid.Row="1" />
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,2">
                    <Button x:Name="MoveOverlayButton" Content="Move overlay…" Width="110" Click="MoveOverlayButton_Click" />
                    <Button x:Name="ResetOverlayButton" Content="Reset position" Width="110" Margin="8,0,0,0" Click="ResetOverlayButton_Click" />
                </StackPanel>
            </Grid>

            <TextBlock Text="General" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel Margin="0,0,0,12">
                <CheckBox x:Name="LaunchAtLoginCheck" Content="Launch at login" Margin="0,2" />
                <CheckBox x:Name="HistoryLoggingCheck" Content="Log dictation history (plain text on disk)" Margin="0,2" />
                <CheckBox x:Name="CorrectionLearningCheck" Content="Suggest dictionary terms from my corrections (experimental)" Margin="0,2" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" Width="90" Click="SaveButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" Click="CancelButton_Click" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
